# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# GitHub personal access token with "repo" scope (Contents: write).
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository. If omitted, derived from the git "origin" remote.
GITHUB_OWNER=eastygh
GITHUB_REPO=Xray-core

# Optional: geo data sources used by --fetch-geo (override to change rule set).
GEOIP_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat
GEOSITE_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat

# Optional: build Android targets (needs the NDK; CGO).
# INCLUDE_ANDROID=1
# ANDROID_NDK_HOME=/path/to/android-ndk
